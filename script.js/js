/* ================= DISQUS ================= */
let disqusLoaded = false;

function loadDisqus() {
  return new Promise(resolve => {
    if (disqusLoaded) return resolve();

    const s = document.createElement("script");
    s.src = `https://${DISQUS_SHORTNAME}.disqus.com/embed.js`;
    s.async = true;
    s.setAttribute("data-timestamp", +new Date());

    s.onload = () => {
      disqusLoaded = true;
      resolve();
    };

    s.onerror = () => {
      console.warn("Falha ao carregar Disqus");
      resolve();
    };

    document.head.appendChild(s);
  });
}

function resetDisqus(id, url) {
  if (window.DISQUS) {
    DISQUS.reset({
      reload: true,
      config: function () {
        this.page.identifier = "codina-" + id + "-v2"; // 🔥 AGORA É ÚNICO REAL
        this.page.url = url;
      }
    });
  }
}

document.addEventListener("click", async (e) => {
  const btn = e.target.closest(".open-comments-btn");
  if (!btn) return;

  const id = btn.dataset.identifier;

  // 🔥 URL única por post
  const url = location.origin + location.pathname + "?post=" + id;

  // 🔥 atualiza a URL no navegador (sem reload)
  history.replaceState(null, "", "?post=" + id);

  const post = btn.closest(".blog-post");
  const extra = post ? post.querySelector(".extra-content") : null;

  let box = document.getElementById("comments-" + id);

  if (!box) {
    box = document.createElement("div");
    box.id = "comments-" + id;
    box.className = "comments-placeholder";
    btn.after(box);
  }

  /* FECHAR */
  if (btn.classList.contains("open")) {
    box.innerHTML = "";
    box.style.display = "none";
    btn.classList.remove("open");
    btn.textContent = "Abrir comentários";
    return;
  }

  /* FECHAR OUTROS */
  document.querySelectorAll(".open-comments-btn.open").forEach(b => {
    if (b !== btn) {
      const otherId = b.dataset.identifier;
      const otherBox = document.getElementById("comments-" + otherId);
      if (otherBox) {
        otherBox.innerHTML = "";
        otherBox.style.display = "none";
      }
      b.classList.remove("open");
      b.textContent = "Abrir comentários";
    }
  });

  /* ABRIR */
  btn.classList.add("open");
  btn.textContent = "Fechar comentários";

  box.style.display = "block";
  box.style.width = "100%";
  box.style.minHeight = "400px";
  box.style.overflow = "visible";
  box.innerHTML = `<div id="disqus_thread"></div>`;

  if (extra) {
    extra.style.maxHeight = "none";
    extra.style.overflow = "visible";
    extra.style.opacity = "1";
  }

  // 🔥 CONFIGURAÇÃO CORRETA
  window.disqus_config = function () {
    this.page.identifier = "codina-" + id + "-v2"; // 🔥 chave única FINAL
    this.page.url = url;
  };

  if (!disqusLoaded) {
    await loadDisqus();
  } else {
    resetDisqus(id, url);
  }

  // 🔥 força render completo
  setTimeout(() => {
    window.dispatchEvent(new Event("resize"));
  }, 500);
});
